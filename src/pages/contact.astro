---
import BaseLayout from '../layouts/BaseLayout.astro';
import Notice from '../components/Notice.astro';
import { MONTHS } from '../data/seasonal';
import { markets } from '../data/countries';
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';
---
<BaseLayout title="Contact Surf and Dive" description="Contact the Surf and Dive editorial team with corrections, updates or questions about planning a luxury surf, dive or freedive holiday." crumbs={[{ label: 'Contact', href: '/contact/' }]}>
  <section class="page-intro">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">Contact</span>
        <h1>Plan Your Ocean Escape</h1>
        <p class="lede">Questions about a destination, a correction to a guide, or an idea for something we should cover. The editorial team reads every message.</p>
        <div class="mt-2">
          <Notice kind="tip" title="Please note">
            <p>Surf and Dive is an independent editorial guide. We do not currently sell holidays, hold availability or quote prices. We will reply with editorial guidance, usually within a few working days.</p>
          </Notice>
        </div>
      </div>

      <form id="contact-form" class="cform" method="post" action={endpoint || undefined} data-endpoint={endpoint} novalidate>
        <p class="req-note">Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.</p>
        <div class="field">
          <label for="name">Name <span aria-hidden="true">*</span></label>
          <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-err" />
          <p class="err" id="name-err" hidden>Please enter your name.</p>
        </div>
        <div class="field">
          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-err" />
          <p class="err" id="email-err" hidden>Please enter a valid email address.</p>
        </div>
        <div class="row2">
          <div class="field">
            <label for="from">Travelling from</label>
            <select id="from" name="from">
              <option value="">Select country</option>
              {markets.map((m) => <option>{m.country}</option>)}
              <option>Elsewhere</option>
            </select>
          </div>
          <div class="field">
            <label for="month">Preferred month</label>
            <select id="month" name="month">
              <option value="">Flexible</option>
              {MONTHS.map((m) => <option>{m.name}</option>)}
            </select>
          </div>
        </div>
        <fieldset class="field">
          <legend>Interested in</legend>
          <div class="checks">
            {['Surf', 'Diving', 'Freediving', 'Luxury stays', 'Something else'].map((i) => (
              <label class="check"><input type="checkbox" name="interests" value={i} /><span>{i}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="field">
          <label for="message">Message <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="6" required minlength="10" aria-describedby="message-err"></textarea>
          <p class="err" id="message-err" hidden>Please write a short message (at least 10 characters).</p>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="field">
          <label class="check consent"><input type="checkbox" name="consent" id="consent" required aria-describedby="consent-err" /><span>I agree that Surf and Dive may use these details to reply to my enquiry, as described in the <a href="/privacy/">privacy policy</a>. <span aria-hidden="true">*</span></span></label>
          <p class="err" id="consent-err" hidden>Please confirm so we can reply.</p>
        </div>
        <button class="btn" type="submit">Send message <span class="arrow" aria-hidden="true">→</span></button>
        <div class="status" id="form-status" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>
</BaseLayout>
<style>
  .contact-grid { display: grid; gap: 3rem; }
  @media (min-width: 980px) { .contact-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 5rem; align-items: start; } }
  .cform { display: grid; gap: 1.25rem; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); background: var(--sand); border-top: 2px solid var(--ocean-teal); }
  .req-note { font-size: 0.82rem; color: var(--slate); }
  .field { display: grid; gap: 0.4rem; border: 0; padding: 0; margin: 0; min-width: 0; }
  label, legend { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; }
  legend { margin-bottom: 0.6rem; }
  input[type='text'], input[type='email'], select, textarea { width: 100%; min-height: 48px; padding: 0.7rem 0.85rem; border: 1px solid #cfc6b5; background: var(--shell); border-radius: var(--radius); font-size: 1rem; }
  textarea { resize: vertical; }
  [aria-invalid='true'] { border-color: #b5583c !important; }
  .err { color: #9a3f25; font-size: 0.85rem; }
  .row2 { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .checks { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .check { display: inline-flex; gap: 0.55rem; align-items: flex-start; text-transform: none; letter-spacing: 0; font-weight: 400; font-size: 0.95rem; min-height: 32px; }
  .check input { width: 18px; height: 18px; margin-top: 0.2rem; accent-color: var(--ocean-teal); flex: none; }
  .consent { font-size: 0.88rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cform .btn { justify-self: start; }
  .status:empty { display: none; }
  .status { padding: 1rem 1.25rem; background: var(--shell); border-left: 3px solid var(--ocean-teal); font-size: 0.95rem; }
  .status.error { border-left-color: #b5583c; }
</style>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  if (form && status) {
    const endpoint = form.dataset.endpoint ?? '';
    const fields: [string, (el: HTMLInputElement | HTMLTextAreaElement) => boolean][] = [
      ['name', (el) => el.value.trim().length > 0],
      ['email', (el) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())],
      ['message', (el) => el.value.trim().length >= 10],
      ['consent', (el) => (el as HTMLInputElement).checked],
    ];
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'status';
      status.textContent = '';
      let firstInvalid: HTMLElement | null = null;
      for (const [id, check] of fields) {
        const el = document.getElementById(id) as HTMLInputElement;
        const err = document.getElementById(`${id}-err`);
        const ok = check(el);
        el.setAttribute('aria-invalid', String(!ok));
        if (err) err.hidden = ok;
        if (!ok && !firstInvalid) firstInvalid = el;
      }
      if (firstInvalid) { firstInvalid.focus(); return; }
      const data = new FormData(form);
      if (String(data.get('website') ?? '')) return; // honeypot
      if (!endpoint) {
        status.textContent = 'Thank you. Our enquiry service is being connected. Please try again shortly. Your message has not been sent.';
        status.classList.add('error');
        return;
      }
      const payload: Record<string, unknown> = {};
      data.forEach((v, k) => {
        if (k === 'website') return;
        if (k === 'interests') payload[k] = [...((payload[k] as string[]) ?? []), String(v)];
        else payload[k] = String(v);
      });
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = 'Thank you. Your message has been sent. The editorial team will reply by email.';
      } catch {
        status.textContent = 'Sorry, your message could not be sent. Please check your connection and try again.';
        status.classList.add('error');
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
