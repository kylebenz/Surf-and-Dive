---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import Notice from '../../components/Notice.astro';
import { comparisons } from '../../data/comparisons';
import { getDestination } from '../../data/destinations';
import { faqLd } from '../../utils/seo';
import type { Comparison } from '../../data/types';

export function getStaticPaths() {
  return comparisons.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Comparison };
const a = getDestination(c.a);
const b = getDestination(c.b);
const aName = c.a_label ?? a.name;
const bName = c.b_label ?? b.name;
const extra = (c.b_also ?? []).map(getDestination);
const guide = (await getCollection('guides')).find((g) => g.id === c.guide);
const scoreRows = [
  ['Surf', a.surf.score, b.surf.score],
  ['Diving', a.diving.score, b.diving.score],
  ['Freediving', a.freediving.score, b.freediving.score],
  ['Luxury', a.luxury.score, b.luxury.score],
  ['Scenery', a.scenery.score, b.scenery.score],
] as const;
---
<BaseLayout
  title={c.seo.title}
  description={c.seo.meta}
  crumbs={[{ label: 'Compare', href: '/compare/' }, { label: c.title, href: `/compare/${c.slug}/` }]}
  jsonLd={[faqLd(c.faqs)]}
>
  <Hero size="medium" eyebrow="Comparison" title={c.h1} subtitle={c.short_answer} seed={`cmp-${c.slug}`}>
    <a class="btn" href="#table">See the comparison <span class="arrow" aria-hidden="true">→</span></a>
    {guide && <a class="btn btn-ghost" href={`/guides/${guide.id}/`}>Read the full guide</a>}
  </Hero>

  <section class="section" aria-labelledby="ov-title">
    <div class="container split-layout">
      <div><span class="eyebrow">The short answer</span><h2 id="ov-title">Different trips, not better or worse</h2></div>
      <div class="prose"><p class="lede">{c.intro}</p></div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="scores-title">
    <div class="container">
      <h2 id="scores-title" class="h3-like">Editorial scores side by side</h2>
      <div class="scores" role="table" aria-label="Editorial scores">
        <div role="row" class="srow head"><span role="columnheader">Criterion</span><span role="columnheader">{aName}</span><span role="columnheader">{bName}</span></div>
        {scoreRows.map(([k, x, y]) => (
          <div role="row" class="srow">
            <span role="rowheader">{k}</span>
            <span role="cell" class:list={[{ hi: x > y }]}>{x}<small>/10</small></span>
            <span role="cell" class:list={[{ hi: y > x }]}>{y}<small>/10</small></span>
          </div>
        ))}
      </div>
      {extra.length > 0 && <p class="note-small mt-1">{bName} scores shown for {b.name}. This comparison also draws on {extra.map((e) => e.name).join(', ')}.</p>}
    </div>
  </section>

  <section id="table" class="section bg-sand" aria-labelledby="table-title">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Twelve criteria</span><h2 id="table-title" class="mt-1">{aName} vs {bName}, criterion by criterion</h2></div>
      <ComparisonTable comparison={c} aName={aName} bName={bName} />
    </div>
  </section>

  <section class="section" aria-labelledby="choose-title">
    <div class="container">
      <h2 id="choose-title" class="sr-only">Who should choose which</h2>
      <div class="cols-2">
        <div class="choose">
          <h3>Choose {aName} if…</h3>
          <ul role="list">{c.choose_a.map((x) => <li>{x}</li>)}</ul>
          <a class="text-link" href={`/destinations/${a.slug}/`}>{a.name} guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="choose">
          <h3>Choose {bName} if…</h3>
          <ul role="list">{c.choose_b.map((x) => <li>{x}</li>)}</ul>
          <a class="text-link" href={`/destinations/${b.slug}/`}>{b.name} guide <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="mt-3" style="max-width:820px"><Notice kind="tip"><p>{c.consider_both}</p></Notice></div>
    </div>
  </section>

  <section class="section bg-seafoam" aria-labelledby="both-title">
    <div class="container">
      <h2 id="both-title" style="margin-bottom:2.5rem">Explore both destinations</h2>
      <ul role="list" class="grid grid-3">
        <li><DestinationCard destination={a} /></li>
        <li><DestinationCard destination={b} /></li>
        {extra.map((e) => <li><DestinationCard destination={e} /></li>)}
      </ul>
      <p class="mt-2 acts">Activity pages: <a href="/surf/">Surf</a> · <a href="/dive/">Dive</a> · <a href="/freediving/">Freedive</a> · <a href="/luxury-ocean-holidays/">Luxury</a></p>
    </div>
  </section>

  {guide && (
    <section class="section" aria-labelledby="guide-title">
      <div class="container narrow">
        <h2 id="guide-title" style="margin-bottom:2rem">Read the full blog post</h2>
        <ArticleCard guide={guide} layout="row" />
      </div>
    </section>
  )}

  <section class="section bg-sand"><div class="container narrow"><FAQ faqs={c.faqs} title={`${aName} vs ${bName}: questions`} /></div></section>
  <CTA seed={`cta-${c.slug}`} title="Compare more escapes" text="See every comparison, or filter all twenty destinations by what matters to you." primary={{ label: 'All comparisons', href: '/compare/' }} secondary={{ label: 'Explore Destinations', href: '/destinations/' }} />
</BaseLayout>
<style>
  .h3-like { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .scores { border-top: 1px solid var(--navy); max-width: 720px; }
  .srow { display: grid; grid-template-columns: 1.2fr 1fr 1fr; padding-block: 0.8rem; border-bottom: 1px solid var(--line); align-items: baseline; }
  .srow.head span { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--slate); font-weight: 600; }
  .srow span[role='rowheader'] { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; }
  .srow span[role='cell'] { font-family: var(--font-display); font-size: 1.5rem; }
  .srow small { font-size: 0.85rem; color: var(--slate); }
  .srow .hi { color: var(--teal-ink); }
  .choose ul { border-top: 1px solid var(--line); margin-bottom: 1.5rem; }
  .choose li { padding: 0.9rem 0 0.9rem 1.5rem; border-bottom: 1px solid var(--line); position: relative; }
  .choose li::before { content: '→'; position: absolute; left: 0; color: var(--teal-ink); }
  .acts { color: #33495c; }
</style>
