---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EditorialSection from '../components/EditorialSection.astro';
import DestinationGrid from '../components/DestinationGrid.astro';
import DestinationList from '../components/DestinationList.astro';
import GuideList from '../components/GuideList.astro';
import Notice from '../components/Notice.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { topFor, getDestination } from '../data/destinations';
import { faqLd, itemListLd } from '../utils/seo';

const best = topFor('freedive', 9);
const pick = (slug: string, note: string) => ({ d: getDestination(slug), note });

const faqs = [
  { question: 'Is freediving safe on a luxury holiday?', answer: 'Freediving requires appropriate training, conservative decisions, a buddy system and respect for local conditions. Use qualified instructors and never treat a destination guide as a substitute for training or local safety advice.' },
  { question: 'Can I freedive alone if I stay shallow?', answer: 'No. Blackouts can happen in shallow water and without warning. Always freedive with a trained buddy who watches you from the surface throughout every dive.' },
  { question: 'Do I need a course?', answer: 'For anything beyond relaxed surface snorkelling, yes. A course with a recognised training organisation teaches breathing, equalisation, safety and rescue. Many of the destinations on this page have established schools.' },
  { question: 'What makes a good freediving destination?', answer: 'Calm, clear water with depth close to shore, qualified local instruction, low boat traffic in training areas, and marine life you can observe respectfully.' },
];
---
<BaseLayout
  title="Freediving Holidays | Surf and Dive"
  description="Freediving holidays with clear water, calm conditions and qualified local support. Destinations, training, safety and responsible freediving, never alone, never competing."
  crumbs={[{ label: 'Freedive', href: '/freediving/' }]}
  jsonLd={[faqLd(faqs), itemListLd(best.map((d) => ({ name: d.name, href: `/destinations/${d.slug}/` })), Astro.site!)]}
>
  <Hero size="medium" eyebrow="Freedive" title="Freediving Holidays" subtitle="Clear water, calm mornings and qualified instruction, for breath-hold exploration approached with patience and respect." seed="freedive-hub">
    <a class="btn" href="#destinations-free">Freediving destinations <span class="arrow" aria-hidden="true">→</span></a>
    <a class="btn btn-ghost" href="#safety">Safety first</a>
  </Hero>

  <section class="section" aria-labelledby="free-intro-title">
    <div class="container split-layout">
      <div><span class="eyebrow">Ocean clarity, responsible exploration</span><h2 id="free-intro-title">Freediving rewards calm</h2></div>
      <div class="prose">
        <p class="lede">Freediving rewards calm, preparation and respect for the ocean. We focus on destinations with appropriate conditions and qualified local support, and we clearly discourage solo diving, unsupervised breath-hold competition, reef contact and overconfidence.</p>
        <p>Scuba diving lets you stay underwater. Freediving asks you to slow down enough to become part of the environment without turning the ocean into a contest. We never present a depth, visibility figure or wildlife encounter as guaranteed.</p>
      </div>
    </div>
  </section>

  <section id="safety" class="section dark" aria-labelledby="safety-title">
    <div class="container split-layout">
      <div><span class="eyebrow">Safety</span><h2 id="safety-title">The rules we never compromise</h2></div>
      <ol role="list" class="rules">
        <li><strong>Never freedive alone.</strong> A trained buddy watches every dive from the surface, one up, one down.</li>
        <li><strong>Use qualified instruction.</strong> Learn and progress with recognised training organisations and local instructors.</li>
        <li><strong>Do not compete</strong> with depth or breath-hold, not with your buddy, your previous best or anyone online.</li>
        <li><strong>Do not hyperventilate.</strong> Use only the breathing techniques your instructor teaches.</li>
        <li><strong>Respect local conditions.</strong> Current, wind, boat traffic and temperature decide whether you dive today.</li>
        <li><strong>Leave wildlife alone.</strong> Keep your distance, never touch coral, never chase an encounter.</li>
      </ol>
    </div>
  </section>

  <EditorialSection id="destinations-free" eyebrow="Destination selection" title="Clear-water freediving destinations" intro="Destinations our editors rate highly for freediving, chosen for water clarity, calm conditions and the presence of qualified local support. The exact site matters more than the country." tone="sand" split>
    <DestinationGrid destinations={best} />
  </EditorialSection>

  <EditorialSection id="training" eyebrow="Training and depth" title="Where to learn and progress" intro="Calm, deep water close to shore and established schools make progression safer and more enjoyable." split>
    <DestinationList activity="freedive" label="Freediving" items={[
      pick('philippines', 'Panglao and Moalboal are established freediving training hubs.'),
      pick('bali-nusa-penida', 'Amed’s calm mornings and depth near shore.'),
      pick('french-polynesia', 'Exceptionally clear lagoons, though pass currents demand caution.'),
      pick('maldives', 'House reefs and lagoons for practice with instructors.'),
      pick('fernando-de-noronha', 'Clear water inside a strictly managed marine park.'),
    ]} />
  </EditorialSection>

  <EditorialSection id="marine" eyebrow="Marine life" title="Encounters on a single breath" intro="Freediving can bring you remarkably close to marine life, precisely because it is quiet. Keep it that way." tone="seafoam" split>
    <div class="cols-2">
      <div class="prose"><p>Turtles, rays and reef fish often tolerate a calm freediver better than a bubbling scuba diver. In places such as <a href="/destinations/mozambique/">Mozambique</a> and <a href="/destinations/maldives/">the Maldives</a>, snorkel-based encounters with whale sharks or manta rays are governed by codes of conduct: limited swimmers, minimum distances, no touching.</p></div>
      <div><Notice kind="responsible"><p>Respect marine life, keep your distance, avoid touching coral and follow protected-area rules. Responsible freediving is not just safer; it is more rewarding.</p></Notice></div>
    </div>
  </EditorialSection>

  <EditorialSection id="free-guides" eyebrow="Blog" title="Freediving blog posts">
    <GuideList ids={['best-freediving-destinations-clear-water', 'how-to-plan-luxury-freediving-holiday', 'ocean-safety-freediving-buddy-systems']} />
    <div class="mt-3"><Notice kind="safety"><p>Our blog posts are general information, not a substitute for training, a qualified instructor or local safety advice.</p></Notice></div>
  </EditorialSection>

  <section class="section bg-sand"><div class="container narrow"><FAQ faqs={faqs} title="Freediving holiday questions" /></div></section>
  <CTA seed="free-cta" />
</BaseLayout>
<style>
  .rules { counter-reset: r; border-top: 1px solid var(--line-dark); }
  .rules li { counter-increment: r; display: grid; grid-template-columns: 3rem 1fr; padding-block: 1.1rem; border-bottom: 1px solid var(--line-dark); color: #d3e3e1; }
  .rules li::before { content: counter(r, decimal-leading-zero); font-family: var(--font-display); color: var(--seafoam); font-size: 1.2rem; }
  .rules strong { color: var(--on-dark); font-weight: 600; }
  .rules li > * { grid-column: 2; }
</style>
