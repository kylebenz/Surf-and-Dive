---
/**
 * One of the ten image slots on a destination page. Resolves the slot to
 * media/destinations/<slug>/<file>.(jpg|png|webp|avif|tif) when present.
 */
import ImageSlot from './ImageSlot.astro';
import type { Destination, ImageSlotType } from '../data/types';
import { slotFile, slotLabel } from '../data/destinations/_images';
import { resolveImage } from '../utils/images';
interface Props {
  destination: Destination;
  type: ImageSlotType;
  aspect?: string;
  priority?: boolean;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { destination, type, aspect, priority, eager, sizes, class: cls } = Astro.props;
const slot = destination.images.find((i) => i.type === type)!;
const image = resolveImage({
  src: slot.src,
  dir: `destinations/${destination.slug}`,
  base: slotFile(type),
  alt: slot.alt,
  caption: slot.caption,
  credit: slot.credit,
});
---
<ImageSlot image={image} label={slotLabel(type)} aspect={aspect} priority={priority} eager={eager} sizes={sizes} class={cls} />
