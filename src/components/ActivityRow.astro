---
/**
 * One row of the homepage "Choose Your Ocean Experience" section, in an alternating layout:
 * the visual and the text sit side by side and swap sides on every other row (the parent list
 * handles the alternation). On phones the visual stacks above the text.
 *
 * The visual is the brand's swell artwork with the row number, or, when `image` (a media key)
 * is given, that photograph at its natural shape (never cropped).
 */
import SwellArt from './SwellArt.astro';
import Picture from './Picture.astro';
import { getImage } from '../utils/images';

interface Props { title: string; text: string; href: string; seed: string; index: number; image?: string }
const { title, text, href, seed, index, image } = Astro.props;
const photo = image ? getImage(image) : null;
const num = String(index).padStart(2, '0');
---
<a class="row" href={href}>
  <div class="visual" style={photo ? `aspect-ratio:${photo.width} / ${photo.height}` : undefined}>
    {photo ? (
      <Picture image={photo} sizes="(min-width: 800px) 50vw, 100vw" alt="" />
    ) : (
      <div class="art" aria-hidden="true">
        <SwellArt seed={seed} lines={12} />
        <span class="num">{num}</span>
      </div>
    )}
  </div>
  <div class="text">
    <h3>{title}</h3>
    <p>{text}</p>
    <span class="go">Explore <span class="arrow" aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .row { display: grid; gap: 1.5rem; align-items: center; color: inherit; text-decoration: none; }
  @media (min-width: 800px) { .row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 1rem + 4vw, 5.5rem); } }

  .visual { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: var(--deep-ocean); }
  .visual :global(img) { width: 100%; height: 100%; transition: transform 1.2s var(--ease); }
  .art { position: absolute; inset: 0; transition: transform 1.2s var(--ease); }
  .art :global(.swell) { opacity: 0.4; transition: opacity 0.6s var(--ease); }
  .num {
    position: absolute; left: clamp(1.25rem, 1rem + 1.5vw, 2.25rem); bottom: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    font-family: var(--font-display); font-size: clamp(3.5rem, 2.5rem + 4vw, 6.5rem); line-height: 1; color: rgba(216, 240, 234, 0.85);
  }
  .row:hover .art, .row:hover .visual :global(img) { transform: scale(1.03); }
  .row:hover .art :global(.swell) { opacity: 0.65; }

  .text { display: grid; gap: 0.75rem; justify-items: start; max-width: 46ch; }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--step-4); line-height: 1.05; letter-spacing: -0.01em; color: var(--navy); }
  p { font-size: var(--step-0); line-height: 1.65; color: var(--slate); }
  .go { margin-top: 0.5rem; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--teal-ink); border-bottom: 1px solid currentColor; padding-bottom: 0.2rem; }
  .go .arrow { display: inline-block; transition: transform 0.3s var(--ease); }
  .row:hover h3 { color: var(--teal-ink); }
  .row:hover .go .arrow { transform: translateX(3px); }
  .row:focus-visible { outline: 2px solid var(--ocean-teal); outline-offset: 6px; }
</style>
