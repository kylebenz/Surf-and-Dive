---
import { swellPaths } from '../utils/contour';
interface Props { seed: string; tone?: 'dark' | 'sand' | 'seafoam'; lines?: number; class?: string; }
const { seed, tone = 'dark', lines = 18, class: cls = '' } = Astro.props;
const { paths, width, height } = swellPaths(seed, { lines });
---
<svg class={`swell s-${tone} ${cls}`} viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {paths.map((d, i) => <path d={d} style={`--o:${(0.25 + (i % 5) * 0.12).toFixed(2)}`} />)}
</svg>
<style>
  .swell { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .swell path { stroke-opacity: var(--o); vector-effect: non-scaling-stroke; }
  .swell.s-dark { stroke: #5fb7b4; }
  .swell.s-sand { stroke: #b9ad97; }
  .swell.s-seafoam { stroke: #6fb3a5; }
</style>
