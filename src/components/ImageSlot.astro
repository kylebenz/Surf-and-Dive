---
/**
 * Renders a real photograph when one has been supplied, or an intentional,
 * designed placeholder when it has not. Never renders a broken image or a
 * placeholder pretending to be a photograph.
 */
import Picture from './Picture.astro';
import type { ResolvedImage } from '../utils/images';
interface Props {
  image: ResolvedImage | null;
  label: string;
  /** Shape of the empty placeholder, e.g. "4 / 3". Photographs always keep their own shape (never cropped). */
  aspect?: string;
  /** The page's LCP image: eager + fetchpriority=high (one per page). */
  priority?: boolean;
  /** Above the fold but not the LCP element. */
  eager?: boolean;
  sizes?: string;
  kind?: 'photo' | 'graphic';
  showCaption?: boolean;
  class?: string;
}
const {
  image,
  label,
  aspect = '4 / 3',
  priority = false,
  eager = false,
  sizes = '(min-width: 1000px) 50vw, 100vw',
  kind = 'photo',
  showCaption = true,
  class: cls = '',
} = Astro.props;
---
{image ? (
  <figure class={`slot has-image ${cls}`}>
    <div class="frame" style={`aspect-ratio:${image.width} / ${image.height}`}>
      <Picture image={image} sizes={sizes} priority={priority} eager={eager} />
    </div>
    {showCaption && (image.caption || image.credit) && (
      <figcaption>
        {image.caption}
        {image.credit && <span class="credit">{image.caption ? ' · ' : ''}{image.credit}</span>}
      </figcaption>
    )}
  </figure>
) : (
  <div class={`slot placeholder ${cls}`} style={`aspect-ratio:${aspect}`} role="img" aria-label={`Image slot: ${label}. Photography to be added.`}>
    <div class="ph-inner" aria-hidden="true">
      <svg class="ph-icon" viewBox="0 0 32 32" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
        {kind === 'graphic'
          ? <><rect x="5" y="7" width="22" height="18" rx="1" /><path d="M9 20l4-5 3 3 4-6 4 8" /></>
          : <><rect x="4" y="7" width="24" height="18" rx="1" /><path d="M4 19c3-2.5 6-2.5 9 0s6 2.5 9 0 4-2 6-1.2" /><circle cx="22" cy="12.5" r="1.8" /></>}
      </svg>
      <span class="ph-kicker">{kind === 'graphic' ? 'Graphic slot' : 'Image slot'}</span>
      <span class="ph-label">{label}</span>
      <span class="ph-note">{kind === 'graphic' ? 'Graphic to be added' : 'Photography to be added'}</span>
    </div>
  </div>
)}

<style>
  .slot { position: relative; width: 100%; margin: 0; }
  .frame { position: relative; overflow: hidden; background: var(--sand-deep); }
  .frame :global(img) {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .has-image:hover .frame :global(img) { transform: scale(1.025); }
  figcaption { margin-top: 0.6rem; font-size: 0.8rem; color: var(--slate); line-height: 1.5; }
  .credit { color: var(--slate); }
  /* Readable captions and credits on dark sections. */
  :global(.dark) figcaption, :global(.dark) .credit { color: var(--on-dark-muted); }

  .placeholder {
    display: grid;
    place-items: center;
    background: var(--sand);
    border: 1px solid var(--line);
    color: var(--slate);
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
    min-height: 160px;
  }
  .placeholder::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px dashed rgba(98, 114, 122, 0.22);
    pointer-events: none;
  }
  .placeholder:hover { background: #f1ebe0; border-color: #cfc6b5; }
  .ph-inner { display: grid; justify-items: center; gap: 0.45rem; text-align: center; padding: 1.25rem; }
  .ph-icon { color: var(--ocean-teal); opacity: 0.7; margin-bottom: 0.25rem; }
  .ph-kicker { font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--slate); }
  .ph-label { font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: var(--navy); max-width: 26ch; line-height: 1.4; }
  .ph-note { font-family: var(--font-display); font-style: italic; font-size: 1.02rem; color: var(--slate); }
</style>
