---
import SwellArt from './SwellArt.astro';
interface Props { title: string; text: string; href: string; eyebrow?: string; seed: string; index?: number; }
const { title, text, href, eyebrow, seed, index } = Astro.props;
---
<a class="activity" href={href}>
  <div class="art" aria-hidden="true"><SwellArt seed={seed} lines={10} /></div>
  <div class="inner">
    {index !== undefined && <span class="idx" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h3>{title}</h3>
    <p>{text}</p>
    <span class="go">Explore <span aria-hidden="true">→</span></span>
  </div>
</a>
<style>
  .activity { position: relative; display: block; isolation: isolate; overflow: hidden; min-height: 300px; background: var(--deep-ocean); color: var(--on-dark); text-decoration: none; height: 100%; }
  .art { position: absolute; inset: 0; z-index: -1; opacity: 0.4; transition: opacity 0.6s var(--ease), transform 1.2s var(--ease); }
  .activity:hover .art { opacity: 0.7; transform: scale(1.04); }
  .inner { height: 100%; display: grid; align-content: end; gap: 0.6rem; padding: clamp(1.25rem, 1rem + 1vw, 2rem); }
  .idx { position: absolute; top: 1.25rem; right: 1.5rem; font-family: var(--font-display); font-size: 1.1rem; color: var(--on-dark-muted); }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--step-3); line-height: 1.05; }
  p { font-size: 0.92rem; color: #c6d9d7; max-width: 38ch; }
  .go { margin-top: 0.5rem; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--seafoam); }
  .activity:hover .go span { display: inline-block; transform: translateX(3px); transition: transform 0.3s var(--ease); }
</style>
