---
/**
 * Affiliate recommendation box: server-rendered HTML and CSS only.
 * Fixed layout (stable min-height, image box with reserved aspect ratio), so it never
 * shifts content, and the disclosure required by our editorial policy is always shown.
 *
 * Usage:
 *   <AffiliateCTA partner="Booking.com" href="https://..." title="Six Senses Laamu"
 *     text="Overwater villas beside a resident manta cleaning station." image="destinations/maldives/luxury"
 *     price="From about €1,200 a night" button="Check dates" />
 */
import AffiliateLink from './AffiliateLink.astro';
import Picture from './Picture.astro';
import { getImage } from '../utils/images';

interface Props {
  partner: string;
  href: string;
  title: string;
  text?: string;
  /** Optional media key for a photo. */
  image?: string;
  /** Price guidance, e.g. "From about €400 a night". */
  price?: string;
  button?: string;
}
const { partner, href, title, text, image, price, button = `View on ${partner}` } = Astro.props;
const img = image ? getImage(image) : null;
---
<aside class={`sd-aff ${img ? 'has-img' : ''}`} aria-label={`Recommendation: ${title}`}>
  {img && <div class="img"><Picture image={img} sizes="(min-width: 640px) 220px, 100vw" /></div>}
  <div class="body">
    <p class="kicker">Where we would stay</p>
    <h3 class="title">{title}</h3>
    {text && <p class="text">{text}</p>}
    <div class="row">
      {price && <p class="price">{price}</p>}
      <AffiliateLink href={href} partner={partner} class="btn">{button} <span class="arrow" aria-hidden="true">→</span></AffiliateLink>
    </div>
    <p class="disclosure">Affiliate link: we may earn a commission if you book, at no extra cost to you. It never influences what we recommend.</p>
  </div>
</aside>

<style>
  .sd-aff { display: grid; gap: 0; min-height: 13rem; background: var(--shell); border: 1px solid var(--line); contain: layout; }
  @media (min-width: 640px) { .sd-aff.has-img { grid-template-columns: 220px minmax(0, 1fr); } }
  .img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--sand-deep); }
  @media (min-width: 640px) { .img { aspect-ratio: auto; } }
  .img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { display: grid; gap: 0.5rem; align-content: start; padding: 1.25rem 1.4rem; }
  .kicker { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: var(--teal-ink); }
  .title { font-family: var(--font-display); font-weight: 500; font-size: var(--step-2); line-height: 1.1; }
  .text { font-size: 0.92rem; color: var(--slate); line-height: 1.55; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.25rem; margin-top: 0.5rem; }
  .price { font-size: 0.88rem; font-weight: 600; color: var(--navy); }
  .disclosure { font-size: 0.74rem; color: var(--slate); margin-top: 0.35rem; }
</style>
