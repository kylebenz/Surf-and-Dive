---
import SwellArt from './SwellArt.astro';
import Picture from './Picture.astro';
import type { ResolvedImage } from '../utils/images';
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: ResolvedImage | null;
  seed?: string;
  size?: 'full' | 'large' | 'medium';
  slotLabel?: string;
  align?: 'bottom' | 'center';
  /** "centered": text centred over the photo with a thin rule under the title and a wave-shaped bottom edge. */
  layout?: 'left' | 'centered';
}
const { eyebrow, title, subtitle, image = null, seed = 'surf-and-dive', size = 'large', slotLabel, align = 'bottom', layout = 'left' } = Astro.props;
const centered = layout === 'centered';
---
<section class={`hero dark ${size} ${centered ? 'center centered' : align}`} aria-labelledby="hero-title">
  <div class="media" aria-hidden={image ? undefined : 'true'}>
    {image ? (
      <>
        {/* Dark teal base: what shows if the photo is slow, so white text never sits on white. */}
        <div class="art" aria-hidden="true"></div>
        <Picture image={image} sizes="100vw" priority color={false} />
        <div class="scrim photo" aria-hidden="true"></div>
        {/* Brand contour lines, faint and faded out over the photo side. */}
        <div class="lines" aria-hidden="true"><SwellArt seed={seed} lines={22} /></div>
      </>
    ) : (
      <>
        <div class="art">
          <SwellArt seed={seed} lines={22} />
          <div class="horizon"></div>
        </div>
        <div class="scrim"></div>
      </>
    )}
  </div>
  <div class="container content">
    {eyebrow && <p class="eyebrow hero-in" style="--d:0">{eyebrow}</p>}
    <h1 id="hero-title" class="hero-in" style="--d:1">{title}</h1>
    {centered && <span class="rule hero-in" style="--d:2" aria-hidden="true"></span>}
    {subtitle && <p class="sub hero-in" style="--d:2">{subtitle}</p>}
    <div class="actions hero-in" style="--d:3"><slot /></div>
  </div>
  {centered && (
    <svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M0 52C180 88 360 92 560 62S900 6 1100 22s260 52 340 40V90H0Z" />
    </svg>
  )}
  {image?.credit && <p class="photo-credit">{image.credit}</p>}
  {!image && slotLabel && (
    <p class="slot-note container"><span>Image slot · {slotLabel} · Photography to be added</span></p>
  )}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: end;
    background: var(--deep-ocean);
  }
  .hero.full { min-height: min(92svh, 920px); }
  .hero.large { min-height: min(78svh, 760px); }
  .hero.medium { min-height: min(58svh, 560px); }
  .hero.center { align-items: center; }
  .media { position: absolute; inset: 0; z-index: -1; }
  .media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .art {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 80% at 75% 10%, rgba(16, 168, 120, 0.16), transparent 60%),
      radial-gradient(90% 70% at 15% 100%, rgba(8, 127, 140, 0.35), transparent 70%),
      linear-gradient(180deg, #0a3240 0%, var(--deep-ocean) 55%, #061f28 100%);
  }
  .art :global(.swell) { opacity: 0.55; }
  .horizon { position: absolute; left: 0; right: 0; top: 34%; height: 1px; background: linear-gradient(90deg, transparent, rgba(216, 240, 234, 0.35), transparent); }
  .scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8, 43, 54, 0.15) 0%, rgba(8, 43, 54, 0.25) 45%, rgba(8, 43, 54, 0.82) 100%); }

  /* Photo heroes. Below 1024px the text spans (nearly) the full width, so the photo shows at
     the top and the brand teal deepens towards the text. From 1024px the text sits left: dark
     behind the text column, clearing to the photo on the right, with a soft bottom gradient as a
     solid base for the buttons. Stops are measured, not eyeballed: every text element meets
     WCAG AA against the brightest pixel behind it (measured at 375-1920px). */
  .scrim.photo {
    background: linear-gradient(180deg, rgba(14, 38, 46, 0.45) 0%, rgba(14, 38, 46, 0.82) 20%, rgba(14, 38, 46, 0.88) 45%, rgba(14, 38, 46, 0.92) 100%);
  }
  @media (min-width: 1024px) {
    .scrim.photo {
      background:
        linear-gradient(0deg, rgba(14, 38, 46, 0.75) 0%, rgba(14, 38, 46, 0) 32%),
        linear-gradient(90deg, rgba(14, 38, 46, 0.88) 0%, rgba(14, 38, 46, 0.8) 45%, rgba(14, 38, 46, 0.78) 58%, rgba(14, 38, 46, 0.3) 76%, rgba(14, 38, 46, 0) 100%);
    }
  }
  .lines {
    position: absolute; inset: 0; opacity: 0.1;
    -webkit-mask-image: linear-gradient(0deg, #000 0%, #000 45%, transparent 80%);
    mask-image: linear-gradient(0deg, #000 0%, #000 45%, transparent 80%);
  }
  @media (min-width: 1024px) {
    .lines {
      -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 30%, transparent 65%);
      mask-image: linear-gradient(90deg, #000 0%, #000 30%, transparent 65%);
    }
  }
  .lines :global(.swell) { opacity: 1; }

  /* Centred layout (homepage): text centred over the photo, a thin rule under the title, and a
     wave-shaped bottom edge. The overlay is darkest behind the centred text (measured for WCAG AA). */
  .centered { text-align: center; }
  .centered .content { display: grid; justify-items: center; padding-block: clamp(5rem, 4rem + 5vw, 8rem) clamp(6rem, 5rem + 5vw, 9.5rem); }
  .centered h1 { margin-inline: auto; max-width: 20ch; }
  .centered .sub { margin-inline: auto; max-width: 52ch; }
  .centered .actions { justify-content: center; }
  .rule { display: block; width: min(30rem, 72%); height: 1px; margin-top: 1.75rem; background: rgba(243, 247, 245, 0.7); }
  .centered .sub { margin-top: 1.5rem; }
  .centered .scrim.photo {
    background:
      radial-gradient(ellipse 75% 65% at 50% 52%, rgba(14, 38, 46, 0.78) 0%, rgba(14, 38, 46, 0.64) 55%, rgba(14, 38, 46, 0.45) 100%),
      linear-gradient(180deg, rgba(14, 38, 46, 0.25) 0%, rgba(14, 38, 46, 0) 30%);
  }
  @media (min-width: 1024px) {
    .centered .scrim.photo {
      background:
        radial-gradient(ellipse 60% 70% at 50% 52%, rgba(14, 38, 46, 0.8) 0%, rgba(14, 38, 46, 0.62) 55%, rgba(14, 38, 46, 0.32) 100%),
        linear-gradient(180deg, rgba(14, 38, 46, 0.25) 0%, rgba(14, 38, 46, 0) 30%);
    }
  }
  .centered .lines { display: none; }
  .wave { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: clamp(28px, 2rem + 3vw, 84px); fill: var(--shell); z-index: 1; }
  .content { padding-block: clamp(5rem, 4rem + 6vw, 9rem) clamp(3rem, 2.5rem + 3vw, 5.5rem); }
  h1 { max-width: 17ch; color: var(--on-dark); }
  .medium h1 { font-size: var(--step-4); max-width: 22ch; }
  .eyebrow { margin-bottom: 1.25rem; }
  .sub { margin-top: 1.5rem; max-width: 58ch; font-size: var(--step-1); line-height: 1.6; color: #dbe8e6; }
  .actions { margin-top: 2.25rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .actions:empty { display: none; }
  .photo-credit {
    position: absolute; right: var(--gutter); bottom: 0.85rem; margin: 0;
    font-size: 0.68rem; letter-spacing: 0.03em; color: rgba(243, 247, 245, 0.78);
    text-shadow: 0 1px 2px rgba(4, 22, 28, 0.45);
  }
  .slot-note { position: absolute; left: 0; right: 0; top: 1.25rem; margin-inline: auto; text-align: right; }
  .slot-note span { font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(216, 240, 234, 0.55); }
  @media (prefers-reduced-motion: no-preference) {
    .hero-in { animation: hero-rise 1.1s var(--ease) both; animation-delay: calc(var(--d) * 110ms + 80ms); }
    /* The headline is usually the LCP element: an opacity fade would delay LCP, so it only rises. */
    h1.hero-in { animation-name: hero-rise-solid; animation-delay: 0ms; }
    .art :global(.swell) { animation: swell-fade 2.4s var(--ease) both; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes hero-rise-solid { from { transform: translateY(10px); } to { transform: none; } }
  @keyframes swell-fade { from { opacity: 0; } to { opacity: 0.55; } }
</style>
