# Canonical production origin (no trailing slash)
SITE_URL=https://www.surfanddive.com

# Optional: endpoint that accepts JSON POSTs from the contact form
# (e.g. a Formspree/Basin/Getform endpoint or your own serverless function).
# If unset, the form validates but tells visitors enquiries are not yet connected.
PUBLIC_CONTACT_ENDPOINT=

# Google Tag Manager container. Defaults to GTM-NWN96HQ3; uncomment and leave empty to disable.
# PUBLIC_GTM_ID=GTM-NWN96HQ3

# Optional direct GA4 tag (G-XXXXXXXXXX). Leave empty if GA4 is set up inside GTM.
PUBLIC_GA4_ID=
